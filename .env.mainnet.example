# Constitutional L2 - Mainnet Configuration
#
# CRITICAL: This is for mainnet deployment with real value at stake.
# Review all settings carefully before deployment.
#
# Copy to .env.mainnet and fill in your values.
#
# Usage:
#   source .env.mainnet
#   ./start.sh mainnet

# =============================================================
# RPC Configuration
# =============================================================

# Mainnet RPC endpoint (use a reliable provider)
RPC_URL=https://mainnet.infura.io/v3/YOUR_API_KEY

# =============================================================
# Arbitrator Contract Addresses (Mainnet)
# =============================================================

# Arbitrator on Mainnet (Kleros Court by default)
ARBITRATOR=0x988b3A538b618C7A603e1c11Ab82Cd16dbE28069

# WETH on Mainnet
WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# Court ID (Blockchain Technical)
COURT_ID=4

# =============================================================
# Deployment Parameters
# =============================================================

# MUST be true for mainnet
PRODUCTION=true

# Override individual parameters (optional, production defaults used if unset)
# SUBMISSION_DEPOSIT=500000000000000000   # 0.5 ETH in wei
# SUBMISSION_PERIOD=604800                 # 7 days
# REINCLUSION_PERIOD=604800                # 7 days
# WITHDRAWING_PERIOD=86400                 # 1 day
# EPOCH_DURATION=86400                     # 24 hours

# Guardian MUST be a multisig for mainnet
# Recommended: Gnosis Safe with 3/5 or higher threshold
GUARDIAN=

# =============================================================
# Keys
#
# SECURITY WARNING:
# - Never commit real private keys
# - Use hardware wallets or secure key management
# - Consider using a deployment script with Ledger/Trezor support
# =============================================================

# Deployer key (needs ~0.1 ETH for deployment gas)
PRIVATE_KEY=

# Batcher key (needs ETH for ongoing batch submissions)
# This address must be:
# 1. Registered in the arbitrator registry (Kleros Curate by default)
# 2. Synced to the manager via syncAddOperator()
BATCHER_PRIVATE_KEY=

# =============================================================
# Etherscan Verification
# =============================================================

ETHERSCAN_API_KEY=

# =============================================================
# Pre-deployment Checklist
# =============================================================
#
# Before deploying to mainnet, verify:
#
# [ ] Guardian is a secure multisig (not an EOA)
# [ ] PRODUCTION=true is set
# [ ] Epoch duration is appropriate for your security model
# [ ] All sequencer operators are ready to register with the arbitrator registry (Kleros default)
# [ ] Keeper infrastructure is ready for automatic rotation
# [ ] Monitoring and alerting is set up
# [ ] Emergency procedures are documented
# [ ] Legal/compliance review is complete (if applicable)
