# Constitutional L2 - Mainnet Configuration
#
# CRITICAL: This is for mainnet deployment with real value at stake.
# Review all settings carefully before deployment.
#
# Copy to .env.mainnet and fill in your values

# =============================================================
# L1 Configuration (Mainnet)
# =============================================================

# Mainnet RPC endpoint (use a reliable provider)
L1_RPC=https://mainnet.infura.io/v3/YOUR_API_KEY

# Mainnet Beacon RPC (required for blob support)
L1_BEACON_RPC=https://ethereum-beacon-api.publicnode.com

# Chain IDs
L1_CHAIN_ID=1
L2_CHAIN_ID=YOUR_L2_CHAIN_ID

# =============================================================
# Contract Addresses
# =============================================================

# Kleros Curate Registry on Mainnet
# Create a new TCR at https://curate.kleros.io/ with your sequencer policy
# Or use an existing TCR that fits your requirements
#
# Required TCR settings:
# - Item type: Address (single address field)
# - Deposit: High enough to deter frivolous submissions (e.g., 32 ETH)
# - Challenge period: Long enough for community review (e.g., 7 days)
# - Arbitrator: Kleros Court on mainnet
REGISTRY=

# OP Stack SystemConfig on Mainnet
# This is the L1 contract deployed as part of your OP Stack
# Found in your OP Stack deployment artifacts
SYSTEM_CONFIG=

# =============================================================
# Manager Configuration
# =============================================================

# Production epoch duration (1 hour recommended)
# Longer epochs = more stability, less frequent rotation
# Shorter epochs = more responsiveness to slashing
EPOCH_DURATION=3600

# Guardian MUST be a multisig for mainnet
# Recommended: Gnosis Safe with 3/5 or higher threshold
# The guardian can pause operations in emergencies
GUARDIAN=

# =============================================================
# Keys
#
# SECURITY WARNING:
# - Never commit real private keys
# - Use hardware wallets or secure key management
# - Consider using a deployment script with Ledger/Trezor support
# =============================================================

# Deployer key (needs ~0.1 ETH for deployment gas)
DEPLOYER_PRIVATE_KEY=

# Batcher key (needs ETH for ongoing batch submissions)
# This address must be:
# 1. Registered in the Kleros Curate registry
# 2. Synced to the manager via syncAddSequencer()
BATCHER_PRIVATE_KEY=

# =============================================================
# Verification
# =============================================================

ETHERSCAN_API_KEY=

# =============================================================
# Pre-deployment Checklist
# =============================================================
#
# Before deploying to mainnet, verify:
#
# [ ] Registry is deployed and has correct policy/constitution
# [ ] SystemConfig is the correct address for your OP Stack
# [ ] Guardian is a secure multisig (not an EOA)
# [ ] Epoch duration is appropriate for your security model
# [ ] All sequencer operators are ready to register in Kleros
# [ ] Keeper infrastructure is ready for automatic rotation
# [ ] Monitoring and alerting is set up
# [ ] Emergency procedures are documented
# [ ] Legal/compliance review is complete (if applicable)
