# Constitutional L2 - Sepolia Testnet Configuration
#
# Copy to .env.sepolia and fill in your values.
#
# Usage:
#   source .env.sepolia
#   ./start.sh sepolia

# =============================================================
# RPC Configuration
# =============================================================

# Sepolia RPC endpoint (Infura, Alchemy, or your own node)
RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# Sepolia Beacon RPC (required for blob support)
L1_BEACON_RPC=https://ethereum-sepolia-beacon-api.publicnode.com

# =============================================================
# Arbitrator Contract Addresses (Sepolia)
# =============================================================

# Arbitrator address on Sepolia (default: Kleros Court, see https://docs.kleros.io)
ARBITRATOR_ADDRESS=0x...

# WETH on Sepolia
WETH=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9

# Court ID (Blockchain Technical)
COURT_ID=4

# =============================================================
# Deployment Parameters
# =============================================================

# Set to "true" to use production parameters (longer periods, higher deposits)
PRODUCTION=false

# Override individual parameters (optional, defaults used if unset)
# SUBMISSION_DEPOSIT=10000000000000000   # 0.01 ETH in wei
# SUBMISSION_PERIOD=300                   # 5 minutes
# REINCLUSION_PERIOD=300                  # 5 minutes
# WITHDRAWING_PERIOD=60                   # 1 minute
# EPOCH_DURATION=300                      # 5 minutes

# Guardian address (your address for testing)
GUARDIAN=

# =============================================================
# Keys (use test keys only!)
# =============================================================

# Deployer private key (fund with Sepolia ETH from a faucet)
PRIVATE_KEY=

# Batcher private key (fund with Sepolia ETH)
BATCHER_PRIVATE_KEY=

# =============================================================
# Etherscan Verification
# =============================================================

ETHERSCAN_API_KEY=
