# Constitutional L2 - Sepolia Testnet Configuration
#
# Copy to .env.sepolia and fill in your values

# =============================================================
# L1 Configuration (Sepolia)
# =============================================================

# Sepolia RPC endpoint (use Infura, Alchemy, or your own node)
L1_RPC=https://sepolia.infura.io/v3/YOUR_API_KEY

# Sepolia Beacon RPC (required for blob support)
L1_BEACON_RPC=https://ethereum-sepolia-beacon-api.publicnode.com

# Chain IDs
L1_CHAIN_ID=11155111
L2_CHAIN_ID=42069

# =============================================================
# Contract Addresses
# =============================================================

# Kleros Curate on Sepolia
# Deploy a new TCR for your sequencer registry or use an existing test one
# Note: Kleros may not have official Curate deployment on Sepolia
# You may need to deploy your own TCR or use a mock for testing
REGISTRY=

# OP Stack SystemConfig on Sepolia
# This comes from your OP Stack L1 deployment
# If using an existing testnet chain, get this from the chain's documentation
SYSTEM_CONFIG=

# =============================================================
# Manager Configuration
# =============================================================

# Shorter epoch for testing (5 minutes)
EPOCH_DURATION=300

# Guardian (your address for testing)
GUARDIAN=

# =============================================================
# Keys (use test keys only!)
# =============================================================

# Test deployer key (fund with Sepolia ETH)
DEPLOYER_PRIVATE_KEY=

# Test batcher key (fund with Sepolia ETH)
BATCHER_PRIVATE_KEY=

# =============================================================
# Etherscan
# =============================================================

ETHERSCAN_API_KEY=
