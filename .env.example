# Constitutional L2 - Environment Configuration
#
# Copy this file to .env.local, .env.sepolia, or .env.mainnet
# and fill in the values for your deployment.

# =============================================================
# L1 Configuration
# =============================================================

# L1 RPC endpoint (required)
# For local: http://localhost:8545
# For Sepolia: https://sepolia.infura.io/v3/<key> or https://eth-sepolia.g.alchemy.com/v2/<key>
# For Mainnet: https://mainnet.infura.io/v3/<key> or https://eth-mainnet.g.alchemy.com/v2/<key>
L1_RPC=

# L1 Beacon RPC (required for blob support on testnets/mainnet)
# For Sepolia: https://sepolia.beaconcha.in/api/v1
# For Mainnet: https://beaconcha.in/api/v1
L1_BEACON_RPC=

# L1 Chain ID
# Local: 31337
# Sepolia: 11155111
# Mainnet: 1
L1_CHAIN_ID=

# =============================================================
# L2 Configuration
# =============================================================

# L2 Chain ID (your rollup's chain ID)
L2_CHAIN_ID=42069

# L2 Block time in seconds
L2_BLOCK_TIME=2

# =============================================================
# Contract Addresses
# =============================================================

# Arbitrator registry address (Kleros Curate by default)
# This is where sequencer operators register and can be challenged
# Deploy a new TCR or use an existing one from https://curate.kleros.io/
REGISTRY=

# OP Stack SystemConfig address
# This is the L1 contract that controls batcher authorization
# Deployed as part of your OP Stack L1 contracts
SYSTEM_CONFIG=

# =============================================================
# Manager Configuration
# =============================================================

# Epoch duration in seconds
# How often the sequencer can be rotated
# Recommended: 3600 (1 hour) for production, 60 for testing
EPOCH_DURATION=3600

# Guardian address
# Can pause the contract in emergencies
# Should be a multisig for production
# Set to 0x0000000000000000000000000000000000000000 to disable
GUARDIAN=

# =============================================================
# Keys (NEVER commit real keys!)
# =============================================================

# Deployer private key (for contract deployment)
DEPLOYER_PRIVATE_KEY=

# Batcher private key (for op-batcher)
# This address must be registered with the arbitrator registry (Kleros default) and synced to the manager
BATCHER_PRIVATE_KEY=

# =============================================================
# Optional: Etherscan Verification
# =============================================================

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=
